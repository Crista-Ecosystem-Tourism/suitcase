# Базовый URL AI Agent (без завершающего слеша), например:
# https://api.crista.online/suitcase-api
# Локально с пробросом порта suitcase_backend:
# http://YOUR_MACHINE_IP:8010
#
# Приоритет: переменная ниже переопределяет expo.extra.apiUrl из app.json
# после перезапуска Metro (npx expo start).
EXPO_PUBLIC_API_URL=https://api.crista.online/suitcase-api
